# Database Configuration
# Replace with your actual database connection string
DATABASE_URL=postgres://avnadmin:password@host:port/database?sslmode=require
# JWT Configuration
# Generate a strong random secret key for production
SECRET_KEY=your-secret-key-change-this-in-production-please-use-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP) – required for sending emails. In production set these in your platform (Coolify, Render, etc.), not only in .env
SMTP_FROM=ca-services@navedhana.com
SMTP_HOST=smtp.hostinger.com
SMTP_PASS=your-smtp-password
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@navedhana.com
SMTP_FROM_NAME=Navedhana
